<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Linop"
    Manufacturer="feigeCode"
    Version="$(Version)"
    UpgradeCode="2EAB58E6-27F7-4D97-81A1-7CE4B50FA294"
    Language="1033"
    Codepage="936"
    InstallerVersion="500"
    Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Linop is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="LinopIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LinopIcon" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLROOT" />
    <WixVariable
      Id="WixUILicenseRtf"
      Value="$(sys.SOURCEFILEDIR)linop-license.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLROOT" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Linop" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Linop" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="ProductFeature" Title="Linop" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ApplicationExecutable" Guid="*">
        <File Id="LinopExecutable" Source="$(SourceDir)\linop.exe" KeyPath="yes" />
      </Component>
      <Component Id="FileAssociationComponent" Guid="*">
        <ProgId Id="Linop.SQLiteDatabase" Description="SQLite Database">
          <Extension Id="db" ContentType="application/vnd.sqlite3">
            <Verb
              Id="open"
              Command="Open with Linop"
              TargetFile="LinopExecutable"
              Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <ProgId Id="Linop.DuckDBDatabase" Description="DuckDB Database">
          <Extension Id="duckdb" ContentType="application/x-duckdb">
            <Verb
              Id="open"
              Command="Open with Linop"
              TargetFile="LinopExecutable"
              Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <ProgId Id="Linop.MarkdownDocument" Description="Markdown Document">
          <Extension Id="md" ContentType="text/markdown">
            <Verb
              Id="open"
              Command="Open with Linop"
              TargetFile="LinopExecutable"
              Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <ProgId Id="Linop.TerminalRecording" Description="Terminal Recording">
          <Extension Id="cast" ContentType="application/x-asciicast">
            <Verb
              Id="open"
              Command="Open with Linop"
              TargetFile="LinopExecutable"
              Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <RegistryValue
          Id="FileAssociationRegistry"
          Root="HKCU"
          Key="Software\Linop"
          Name="FileAssociationsInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
      <!-- 快捷方式一律不引用 Icon 表：MSI 会把 Icon 表里的图标另存成一份文件，那份文件
           被清理或图标缓存失效后，快捷方式图标就退化成通用白纸（issue #325）。
           linop.exe 已内嵌同一份图标（crates/linop_app/build.rs），留空即由目标 exe 提供。 -->
      <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="*">
        <Shortcut
          Id="StartMenuShortcut"
          Name="Linop"
          Description="Linop - Database, SSH, Terminal, AI Tools"
          Target="[#LinopExecutable]"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="no" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Id="StartMenuShortcutRegistry"
          Root="HKCU"
          Key="Software\Linop"
          Name="StartMenuShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <!-- 同 StartMenuShortcut：不引用 Icon 表，图标取自 linop.exe 的内嵌资源。 -->
        <Shortcut
          Id="DesktopShortcut"
          Name="Linop"
          Description="Linop - Database, SSH, Terminal, AI Tools"
          Target="[#LinopExecutable]"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="no" />
        <RegistryValue
          Id="DesktopShortcutRegistry"
          Root="HKCU"
          Key="Software\Linop"
          Name="DesktopShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
